# Copy to .env and fill in your own values. Never commit a real .env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Your own logged-in Zepto session cookie (copy from your browser's DevTools
# on zepto.com). Must include store_id and XSRF-TOKEN. Rotate it if it stops working.
ZEPTO_COOKIE=
ZEPTO_XSRF_TOKEN=
ZEPTO_STORE_ID=
ZEPTO_DEVICE_ID=
# Delivery location used by the BFF calls (defaults: Bengaluru 12.9716, 77.5946).
ZEPTO_LAT=12.9716
ZEPTO_LNG=77.5946
MIN_DISCOUNT=50
# Print the messages instead of sending them (local test / workflow dry run).
# DRY_RUN=true
